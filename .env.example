# Shopify Storefront API credentials.
#
# Leave both unset to run against https://mock.shop/api (no token
# required) — the template works out of the box with demo data.
#
# NEXT_PUBLIC_STORE_DOMAIN: your store's myshopify domain,
#   e.g. your-store.myshopify.com
# NEXT_PUBLIC_STOREFRONT_API_TOKEN: a public Storefront API access token
#   (Admin → Settings → Apps and sales channels → Develop apps).
NEXT_PUBLIC_STORE_DOMAIN=
NEXT_PUBLIC_STOREFRONT_API_TOKEN=


# Multi-tenant local testing (optional; monorepo only). When the repo
# has a stores/ registry, set DEV_STORE to a registry slug to make
# localhost / *.vercel.app serve that store (see middleware.ts).
# Unset, dev hosts keep the env-configured single-tenant store above.
# DEV_STORE=<registry-slug>

# On-demand cache invalidation secret for POST /api/revalidate
# (unset → the route is disabled).
# REVALIDATE_SECRET=
