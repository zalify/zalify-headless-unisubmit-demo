[
  {
    "name": "theme_info",
    "theme_name": "Zalify",
    "theme_version": "3.2.0",
    "theme_author": "Zalify",
    "theme_documentation_url": "https://zalify.com",
    "theme_support_url": "https://zalify.com"
  },
  {
    "name": "t:general.brand",
    "settings": [
      {
        "type": "text",
        "id": "brand_name",
        "label": "t:labels.brand_name",
        "info": "t:info.brand_name"
      }
    ]
  },
  {
    "name": "t:general.favicon",
    "settings": [
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "t:labels.favicon",
        "info": "t:info.favicon"
      }
    ]
  },
  {
    "name": "t:general.typography",
    "settings": [
      {
        "type": "header",
        "content": "t:general.fonts"
      },
      {
        "type": "font_picker",
        "id": "type_body_font",
        "default": "work_sans_n4",
        "label": "t:labels.body_font"
      },
      {
        "type": "text",
        "id": "type_body_google",
        "label": "t:labels.body_google_font",
        "info": "t:info.google_font"
      },
      {
        "type": "font_picker",
        "id": "type_heading_font",
        "default": "work_sans_n4",
        "label": "t:labels.heading_font"
      },
      {
        "type": "text",
        "id": "type_heading_google",
        "label": "t:labels.heading_google_font",
        "info": "t:info.google_font"
      },
      {
        "type": "text",
        "id": "type_mono_google",
        "label": "t:labels.mono_google_font",
        "info": "t:info.google_font_mono"
      }
    ]
  },
  {
    "name": "t:general.layout",
    "settings": [
      {
        "type": "select",
        "id": "max_page_width",
        "label": "t:labels.page_width",
        "options": [
          {
            "value": "90rem",
            "label": "t:options.page_width.narrow"
          },
          {
            "value": "110rem",
            "label": "t:options.page_width.wide"
          }
        ],
        "default": "90rem"
      },
      {
        "type": "range",
        "id": "min_page_margin",
        "min": 10,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "t:labels.page_margin",
        "default": 20
      }
    ]
  },
  {
    "name": "t:general.colors",
    "settings": [
      {
        "type": "color_scheme_group",
        "id": "color_schemes",
        "definition": [
          {
            "type": "color",
            "id": "background",
            "label": "t:labels.background",
            "default": "#FFFFFF"
          },
          {
            "type": "color",
            "id": "text",
            "label": "t:labels.text",
            "default": "#1A1A1A"
          },
          {
            "type": "color",
            "id": "accent",
            "label": "t:labels.accent",
            "default": "#F26B8A"
          },
          {
            "type": "color",
            "id": "button",
            "label": "t:labels.button",
            "default": "#1A1A1A"
          },
          {
            "type": "color",
            "id": "button_label",
            "label": "t:labels.button_label",
            "default": "#FFFFFF"
          }
        ],
        "role": {
          "background": "background",
          "text": "text",
          "primary_button": "button",
          "on_primary_button": "button_label",
          "primary_button_border": "button",
          "secondary_button": "background",
          "on_secondary_button": "text",
          "secondary_button_border": "text",
          "icons": "text",
          "links": "text"
        }
      }
    ]
  },
  {
    "name": "t:general.social_media",
    "settings": [
      {
        "type": "text",
        "id": "social_instagram",
        "label": "t:labels.social_instagram"
      },
      {
        "type": "text",
        "id": "social_tiktok",
        "label": "t:labels.social_tiktok"
      },
      {
        "type": "text",
        "id": "social_x",
        "label": "t:labels.social_x"
      },
      {
        "type": "text",
        "id": "social_facebook",
        "label": "t:labels.social_facebook"
      },
      {
        "type": "text",
        "id": "social_youtube",
        "label": "t:labels.social_youtube"
      },
      {
        "type": "text",
        "id": "social_pinterest",
        "label": "t:labels.social_pinterest"
      }
    ]
  },
  {
    "name": "t:general.product_cards",
    "settings": [
      {
        "type": "select",
        "id": "card_swatch_style",
        "label": "t:labels.card_swatch_style",
        "options": [
          {
            "value": "swatch",
            "label": "t:options.swatch_style.swatches"
          },
          {
            "value": "variant_image",
            "label": "t:options.swatch_style.variant_images"
          },
          {
            "value": "none",
            "label": "t:options.swatch_style.none"
          }
        ],
        "default": "variant_image"
      },
      {
        "type": "select",
        "id": "card_density",
        "label": "t:labels.density",
        "options": [
          {
            "value": "comfortable",
            "label": "t:options.density.comfortable"
          },
          {
            "value": "compact",
            "label": "t:options.density.compact"
          }
        ],
        "default": "comfortable"
      },
      {
        "type": "checkbox",
        "id": "card_show_quick_add",
        "label": "t:labels.show_quick_add",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "card_show_secondary_image",
        "label": "t:labels.show_secondary_image",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "card_show_rating",
        "label": "t:labels.show_rating",
        "info": "t:info.show_rating",
        "default": false
      },
      {
        "type": "paragraph",
        "content": "t:info.swatch_colors"
      }
    ]
  },
  {
    "name": "t:general.badges",
    "settings": [
      {
        "type": "select",
        "id": "card_badge_position",
        "label": "t:labels.badge_position",
        "options": [
          {
            "value": "corner",
            "label": "t:options.badge_position.on_image"
          },
          {
            "value": "below",
            "label": "t:options.badge_position.below_image"
          }
        ],
        "default": "corner"
