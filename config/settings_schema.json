        "default": "#F26B8A"
      },
      {
        "type": "color",
        "id": "card_badge_sale_text",
        "label": "t:labels.sale_badge_text",
        "default": "#FFFFFF"
      },
      {
        "type": "header",
        "content": "t:general.badge_style_1"
      },
      {
        "type": "text",
        "id": "badge_style_1_labels",
        "label": "t:labels.badge_labels",
        "info": "t:info.badge_labels",
        "default": "New"
      },
      {
        "type": "color",
        "id": "badge_style_1_background",
        "label": "t:labels.badge_background",
        "default": "#1A1A1A"
      },
      {
        "type": "color",
        "id": "badge_style_1_text",
        "label": "t:labels.badge_text",
        "default": "#FFFFFF"
      },
      {
        "type": "header",
        "content": "t:general.badge_style_2"
      },
      {
        "type": "text",
        "id": "badge_style_2_labels",
        "label": "t:labels.badge_labels",
        "info": "t:info.badge_labels"
      },
      {
        "type": "color",
        "id": "badge_style_2_background",
        "label": "t:labels.badge_background",
        "default": "#F9EDEF"
      },
      {
        "type": "color",
        "id": "badge_style_2_text",
        "label": "t:labels.badge_text",
        "default": "#1A1A1A"
      },
      {
        "type": "paragraph",
        "content": "t:info.badge_metaobjects"
      }
    ]
  },
  {
    "name": "t:general.appearance",
    "settings": [
      {
        "type": "header",
        "content": "t:general.corner_radius"
      },
      {
        "type": "range",
        "id": "button_corner_radius",
        "min": 0,
        "max": 30,
        "step": 1,
        "unit": "px",
        "label": "t:labels.button_corner_radius",
        "default": 0
      },
      {
        "type": "range",
        "id": "input_corner_radius",
        "min": 0,
        "max": 10,
        "step": 1,
        "unit": "px",
        "label": "t:labels.input_corner_radius",
        "default": 0
      },
      {
        "type": "range",
        "id": "card_corner_radius",
        "min": 0,
        "max": 30,
        "step": 1,
        "unit": "px",
        "label": "t:labels.card_corner_radius",
        "default": 0
      }
    ]
  }
]
